# ==============================================================================
# FIDSS Environment Configuration
# ==============================================================================

# Application Environment: 'production', 'development', or 'demo'
APP_ENV=development
APP_NAME=FIDSS
DEBUG=true

# Database Configuration (MySQL 8 for Production, SQLite supported for quick demo)
# Production MySQL Example:
# DATABASE_URL=mysql+pymysql://fidss_user:fidss_password@localhost:3306/fidss
# Development / Demo Local Example:
DATABASE_URL=sqlite:///./fidss_app.db

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Storage & Upload Limits
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# Seed Passwords (Driven by environment variables, never hardcoded in production)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=AdminSecure2026!
SEED_OFFICER_USERNAME=arjun
SEED_OFFICER_PASSWORD=OfficerArjun2026!

# System Thresholds
FACE_SIMILARITY_THRESHOLD=0.65
WATCHLIST_PROVIDER=local
AUDIT_PROVIDER=local
