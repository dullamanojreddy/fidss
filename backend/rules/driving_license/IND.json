{
  "document_type": "driving_license",
  "country": "IND",
  "_comment": "# APPROXIMATE \u2014 verify against real sample documents. Flexible format for state code and RTO.",
  "required_fields": [
    "document_number",
    "date_of_birth",
    "date_of_expiry"
  ],
  "date_order_rules": [
    {
      "before_field": "date_of_birth",
      "after_field": "date_of_issue",
      "rule": "date_of_birth must precede date_of_issue"
    },
    {
      "before_field": "date_of_issue",
      "after_field": "date_of_expiry",
      "rule": "date_of_issue must precede date_of_expiry"
    }
  ],
  "expiry_thresholds_days": {
    "expiring_soon": 30
  },
  "document_number_pattern": "^[A-Z]{2}[- ]?[0-9]{2}[- ]?[0-9]{4}[- ]?[0-9]{7}$"
}